{
  "name": "@triptown/gate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5178",
    "build": "vite build && node scripts/check-no-mock.mjs && node scripts/check-audio-budget.mjs",
    "preview": "vite preview --port 5178",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "atlas": "node scripts/build-atlas.mjs",
    "audio": "node scripts/build-audio.mjs",
    "check:copy": "node ../../packages/crash-client/scripts/copy-check.mjs",
    "check:presentation": "node ../../packages/crash-client/scripts/presentation-check.mjs --url http://127.0.0.1:5178/",
    "check:timing": "node ../../packages/crash-client/scripts/timing-check.mjs --url http://127.0.0.1:5178/ --min-ms 5000"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/bungee": "^5.2.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@triptown/core": "workspace:*",
    "@triptown/crash-client": "workspace:*",
    "@triptown/engine": "workspace:*",
    "@triptown/fairness": "workspace:*",
    "@triptown/rgs-client": "workspace:*",
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "maxrects-packer": "^2.7.3",
    "pngjs": "^7.0.0",
    "@breezystack/lamejs": "^1.2.7",
    "webm-muxer": "^5.1.4"
  }
}
