{
  "name": "@triptown/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5180",
    "assemble": "tsx scripts/assemble-demos.ts",
    "check": "tsx scripts/check-site.ts",
    "prebuild": "pnpm run assemble && pnpm run check",
    "build": "next build",
    "start": "next start --port 5180",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "tsx scripts/e2e-gate.ts",
    "check:motion": "tsx scripts/motion-check.ts",
    "check:layout": "tsx scripts/layout-check.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.23.13"
  }
}
