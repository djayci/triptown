{
  "name": "@triptown/gallop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "vite build && node scripts/check-no-mock.mjs && node scripts/check-vocabulary.mjs dist && node scripts/check-audio-budget.mjs",
    "preview": "vite preview --port 5175",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:presentation": "node scripts/presentation-check.mjs",
    "check:rules": "node scripts/rules-check.mjs",
    "audio": "node scripts/build-audio.mjs",
    "check:audio": "node scripts/check-audio-budget.mjs"
  },
  "dependencies": {
    "@triptown/core": "workspace:*",
    "@triptown/engine": "workspace:*",
    "@triptown/fairness": "workspace:*",
    "@triptown/rgs-client": "workspace:*",
    "pixi.js": "^8.20.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@triptown/steps": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "@breezystack/lamejs": "^1.2.7",
    "webm-muxer": "^5.1.4"
  }
}
