{
  "name": "@triptown/flock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5179",
    "build": "vite build && node scripts/check-no-mock.mjs && node scripts/check-audio-budget.mjs",
    "preview": "vite preview --port 5179",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "atlas": "node scripts/build-atlas.mjs",
    "audio": "node scripts/build-audio.mjs",
    "check:copy": "node ../../packages/crash-client/scripts/copy-check.mjs",
    "check:presentation": "node ../../packages/crash-client/scripts/presentation-check.mjs --url http://127.0.0.1:5179/",
    "check:timing": "node ../../packages/crash-client/scripts/timing-check.mjs --url http://127.0.0.1:5179/ --min-ms 5000",
    "check:layout": "node ../../packages/crash-client/scripts/layout-check.mjs --url http://127.0.0.1:5179/ --out ../../docs/compliance/evidence/layout/flock"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@triptown/core": "workspace:*",
    "@triptown/crash-client": "workspace:*",
    "@triptown/engine": "workspace:*",
    "@triptown/fairness": "workspace:*",
    "@triptown/rgs-client": "workspace:*",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/howler": "^2.2.13",
    "maxrects-packer": "^2.7.3",
    "pngjs": "^7.0.0",
    "vite": "^8.3.0"
  }
}
